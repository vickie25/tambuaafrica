# Public site URL (required on Vercel Production: https://tambuaafrica.com)
# VITE_SITE_URL=http://localhost:8080
VITE_SITE_URL=https://tambuaafrica.com

# Google Analytics 4 (optional — page views + contact form conversions)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Auth emails (Supabase Edge Function auth-send-email + Resend hook)
# RESEND_API_KEY=re_xxxx
# AUTH_FROM_EMAIL=Tambua Africa Tours & Safaris <onboarding@resend.dev>
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...  (from Supabase Auth → Hooks → Send Email)
# Set false only if "Confirm email" is ON in Supabase and you want Resend to send links:
# AUTH_SKIP_EMAIL_HOOK=true

# Supabase Configuration (must be saved as `.env` in project root — restart dev server after changes)
# Dashboard → Project Settings → API → Project URL and anon public key (starts with eyJ...)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the anon/public JWT — NOT sb_publishable_* or service_role keys
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional alias (same value as above):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# For local/CI: optional Stripe Price ID to run scripts/smoke-booking-payments.cjs when
# public.safaris.stripe_price_id is empty. Production should set each safari’s stripe Price ID in Supabase.
# SMOKE_STRIPE_PRICE_ID=price_xxxxxxxx
#
# Gemini (Ashley chat): set as a Supabase Edge Function secret for production:
#   supabase secrets set GEMINI_API_KEY=your_key
# For local `supabase functions serve`, use supabase/.env (gitignored) — see supabase/functions/gemini-chat.
#
# One-off Supabase Auth admin bootstrap (node update-admin.js or update-admin.cjs from repo root):
# ADMIN_EMAIL=info@tambua-africa.com
# COMPANY_NOTIFICATION_EMAIL=info@tambua-africa.com,isaac@tambua-africa.com,jorim@tambua-africa.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Tambua Africa Admin
