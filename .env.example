# Quote values that contain spaces or special characters:
AUTH_FROM_EMAIL="Tambua Africa Tours & Safaris <onboarding@resend.dev>"
AUTH_REPLY_TO=info@tambuaafrica.com
SEND_EMAIL_HOOK_SECRET="v1,whsec_your_hook_secret_from_supabase_dashboard"
AUTH_SKIP_EMAIL_HOOK=true

# Set to 1 to skip Playwright prerender during build
# SKIP_PRERENDER=1
